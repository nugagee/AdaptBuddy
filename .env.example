# Copy to .env.local for local dev.
# For Vercel: Project → Settings → Environment Variables (Production + Preview + Development).
# CRA inlines these at BUILD time — you must redeploy after changing them.

REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# OpenAI is server-only. Never prefix these variables with REACT_APP_.
# Configure them in Vercel Project → Settings → Environment Variables.
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Teacher assignment suggestions: opt in per environment after testing.
# Uses only teacher-reviewed task text; never use REACT_APP_ for these.
# Set provider budget controls before enabling. No paid calls when false.
ASSIGNMENT_AI_ENABLED=false
ASSIGNMENT_AI_MODEL=gpt-4o-mini

#   curl -I https://YOUR_PROJECT_REF.supabase.co/auth/v1/health
#
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://adaptbuddy-platform.vercel.app
#   Redirect URLs: https://adaptbuddy-platform.vercel.app/**
